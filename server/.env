# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-local-development-minimum-32-characters-long
JWT_EXPIRES_IN=30d

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=https://classroom-assignment-pqcj.vercel.app
FRONTEND_URL=https://classroom-assignment-pqcj.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Security Configuration
SESSION_SECRET=your-super-secret-session-key-for-cross-origin-deployment-minimum-32-characters-long
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=365

# Notification Configuration
NOTIFICATION_RETENTION_DAYS=30

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true

# Development Settings
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# CORS Configuration
CORS_ORIGIN=https://classroom-assignment-pqcj.vercel.app,http://localhost:5173,http://localhost:3000

