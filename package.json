{
  "name": "classroom-assignment-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A comprehensive classroom assignment management portal",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "vite build",
    "build:server": "cd server && npm install",
    "deploy": "node deploy-to-vercel.js",
    "deploy:manual": "npm run build && vercel --prod",
    "verify:deployment": "node verify-vercel-deployment.js",
    "setup:vercel-env": "node setup-vercel-env.js",
    "deploy:cloudrun": "chmod +x deploy-cloudrun.sh && ./deploy-cloudrun.sh",
    "deploy:cloudrun-win": "deploy-cloudrun.bat",
    "cloudrun:set-env": "chmod +x set-cloudrun-env.sh && ./set-cloudrun-env.sh",
    "cloudrun:set-env-win": "set-cloudrun-env.bat",
    "test:cloudrun": "node test-cloudrun-deployment.js",
    "setup:production": "node setup-production.js",
    "test:deployment": "node test-deployment.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/server.js",
    "start:prod": "NODE_ENV=production node server/server.js",
    "vercel-build": "npm run build",
    "seed": "cd server && npm run seed",
    "test": "echo \"No tests specified\" && exit 0",
    "test:api": "node test-api.js",
    "test:local": "echo \"Starting local testing...\" && npm run test:api",
    "generate-admin": "node generate-admin-hash.js",
    "fix-passwords": "node fix-passwords.js",
    "test-passwords": "node test-password-hashing.js",
    "setup-email": "node setup-email.js",
    "debug-email": "node debug-email.js",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "classroom",
    "assignment",
    "education",
    "portal",
    "react",
    "node",
    "mongodb"
  ],
  "author": "Classroom Assignment Portal Team",
  "license": "MIT"
}
