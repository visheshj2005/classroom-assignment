    {
      "name": "🔐 Login - Test Invalid Credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nonexistent@example.com\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": {
          "raw": "{{render_url}}/auth/login",
          "host": ["{{render_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Test login with invalid credentials to verify error handling"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "console.log('🔐 Invalid Login Response:', JSON.stringify(response, null, 2));",
              "console.log('📊 Status Code:', pm.response.code);",
              "",
              "pm.test('❌ Invalid login properly rejected', function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(response.success).to.be.false;",
              "    pm.expect(response.message).to.include('Invalid email or password');",
              "});",
              "",
              "console.log('✅ Security test passed - invalid credentials rejected');"
            ]
          }
        }
      ]
    },
    {
      "name": "🔍 Compare Localhost vs Render",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@classroom.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{localhost_url}}/auth/login",
          "host": ["{{localhost_url}}"],
          "path": ["auth", "login"]
        },
        "description": "Test same credentials on localhost for comparison (change URL to localhost_url)"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "console.log('🏠 Localhost Login Response:', JSON.stringify(response, null, 2));",
              "console.log('📊 Status Code:', pm.response.code);",
              "",
              "if (response.success) {",
              "    pm.test('✅ Localhost login successful', function () {",
              "        pm.response.to.have.status(200);",
              "        pm.expect(response.success).to.be.true;",
              "    });",
              "    ",
              "    console.log('✅ LOCALHOST SUCCESS!');",
              "    console.log('👤 User:', response.data.user.name);",
              "    console.log('🎭 Role:', response.data.user.role);",
              "    ",
              "    // Compare with Render results",
              "    const renderWorking = pm.globals.get('login_successful');",
              "    if (renderWorking) {",
              "        console.log('🎉 BOTH LOCALHOST AND RENDER WORKING!');",
              "    } else {",
              "        console.log('⚠️  Localhost works but Render has issues');",
              "    }",
              "} else {",
              "    console.log('❌ Localhost login failed:', response.message);",
              "    console.log('🔧 Check if local server is running on port 8080');",
              "}"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Global pre-request script",
          "console.log('🚀 Starting request to:', pm.request.url.toString());",
          "console.log('📅 Timestamp:', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Global test script",
          "console.log('⏱️  Response time:', pm.response.responseTime + 'ms');",
          "console.log('📦 Response size:', pm.response.responseSize + ' bytes');",
          "console.log('---');"
        ]
      }
    }
  ]
